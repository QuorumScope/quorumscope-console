  "components": {
    "schemas": {
      "BypassResponse": {
        "type": "object",
        "required": [
          "tx_hash",
          "network_id",
          "active_since",
          "last_changed"
        ],
        "properties": {
          "active_since": {
            "type": "integer",
            "format": "int64"
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_changed": {
            "type": "integer",
            "format": "int64"
          },
          "network_id": {
            "type": "string",
            "format": "uuid"
          },
          "tx_hash": {
            "type": "string"
          }
        }
      },
      "BypassesResponse": {
        "type": "object",
        "required": [
          "items",
          "page",
          "page_size"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BypassResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "page_size": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message"
