        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "FreezeStateResponse": {
        "type": "object",
        "required": [
          "network_id",
          "frozen_key_count",
          "bypass_count",
          "active_incident_count"
        ],
        "properties": {
          "active_incident_count": {
            "type": "integer",
            "format": "int64"
          },
          "bypass_count": {
            "type": "integer",
            "format": "int64"
          },
          "frozen_key_count": {
            "type": "integer",
            "format": "int64"
          },
          "latest_ledger": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "network_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "FrozenKeyResponse": {
        "type": "object",
        "required": [
          "id",
          "network_id",
          "active_since",
          "last_changed"
        ],
        "properties": {
          "active_since": {
            "type": "integer",
            "format": "int64"
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "id": {
            "type": "string"
          },
          "last_changed": {
            "type": "integer",
            "format": "int64"
          },
          "network_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "FrozenKeysResponse": {
        "type": "object",
        "required": [
          "items",
          "page",
          "page_size"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FrozenKeyResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "page_size": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "required": [
          "status"
        ],
        "properties": {
          "status": {
            "type": "string"
          }
        }
      },
      "IncidentResponse": {
        "type": "object",
        "required": [
          "id",
          "network_id",
          "basis",
          "opened_ledger",
          "status"
        ],
        "properties": {
          "basis": {
            "type": "string"
          },
          "closed_close_time": {
            "type": [
              "string",
              "null"
            ]
          },
          "closed_ledger": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "network_id": {
            "type": "string",
            "format": "uuid"
          },
          "opened_close_time": {
            "type": [
              "string",
              "null"
            ]
          },
          "opened_ledger": {
