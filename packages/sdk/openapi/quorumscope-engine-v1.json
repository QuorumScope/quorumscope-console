            "schema": {
              "type": "string"
            }
          },
          {
            "name": "key_id",
            "in": "query",
            "description": "Restrict direct records to one 64-character hexadecimal key hash.",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
