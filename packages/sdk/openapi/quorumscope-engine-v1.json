  "components": {
    "schemas": {
      "BypassResponse": {
        "type": "object",
        "required": [
          "tx_hash",
          "network_id",
          "active_since",
          "last_changed"
        ],
        "properties": {
          "active_since": {
            "type": "integer",
            "format": "int64"
          },
          "evidence_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_changed": {
            "type": "integer",
            "format": "int64"
          },
          "network_id": {
            "type": "string",
            "format": "uuid"
          },
          "tx_hash": {
            "type": "string"
          }
        }
      },
      "BypassesResponse": {
        "type": "object",
        "required": [
          "items",
          "page",
          "page_size"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/BypassResponse"
            }
          },
          "page": {
            "type": "integer",
            "format": "int64"
          },
          "page_size": {
            "type": "integer",
            "format": "int64"
          }
        }
      },
      "Compatibility": {
        "type": "string",
        "enum": [
          "verified",
          "unverified_protocol",
          "unknown"
        ]
      },
      "ErrorBody": {
        "type": "object",
        "required": [
          "code",
          "message",
          "details",
          "request_id"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "details": {
            "type": "object",
            "description": "Safe structured context. Empty when there is none."
          },
          "message": {
            "type": "string"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "description": "Same value as the top-level `request_id` and the `x-request-id` header."
          }
        }
      },
      "ErrorEnvelope": {
        "type": "object",
        "required": [
          "error",
          "request_id"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          },
          "request_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "FindingResponse": {
        "type": "object",
        "required": [
          "status",
          "confidence",
          "implicated_keys",
          "protocol_path",
          "explanation"
        ],
        "properties": {
          "confidence": {
            "$ref": "#/components/schemas/PreflightConfidenceResponse"
          },
          "explanation": {
            "type": "string"
          },
          "implicated_keys": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Frozen key hashes (hex) this finding implicates."
          },
          "protocol_path": {
            "type": "string",
            "description": "Where in the transaction the finding applies."
          },
          "status": {
            "$ref": "#/components/schemas/PreflightStatusResponse"
          }
        }
      },
      "FreezeStateResponse": {
        "type": "object",
        "required": [
          "freshness",
          "network_id",
          "frozen_key_count",
          "bypass_count",
          "active_incident_count"
        ],
        "properties": {
          "active_incident_count": {
            "type": "integer",
            "format": "int64"
          },
          "bypass_count": {
            "type": "integer",
            "format": "int64"
          },
          "freshness": {
            "$ref": "#/components/schemas/StateFreshness"
          },
          "frozen_key_count": {
            "type": "integer",
            "format": "int64"
          },
          "latest_ledger": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "network_id": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "FreshnessStatus": {
        "type": "string",
        "enum": [
          "current",
          "indexing_behind",
          "stale",
          "unknown"
        ]
      },
      "FrozenKeyDetailResponse": {
        "allOf": [
          {
            "$ref": "#/components/schemas/FrozenKeyResponse"
          },
          {
            "type": "object",
            "required": [
              "history"
            ],
            "properties": {
              "history": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/KeyChangeResponse"
                },
                "description": "Every recorded freeze and unfreeze, oldest first. Covers only ledgers the\nindexer has observed."
              }
            }
          }
        ]
      },
